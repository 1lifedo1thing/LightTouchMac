#!/bin/bash
# The pinned source checkouts (build-support/sources.json): one resolver for every script.
#
#     scripts/sources qemu-ios | usbmuxd     the checkout path (QEMU_IOS_DIR / USBMUXD_SOURCE_DIR override it)
#     scripts/sources qemu-build             the development QEMU build directory (QEMU_BUILD_DIR overrides it):
#                                            <qemu-ios>/<build_dir>, where libqemu-arm.dylib is
#     scripts/sources commit NAME            the pinned commit
#     scripts/sources check                  pinned vs the checkouts' HEAD; exit 1 on a difference
#
# Configuration/Shared.xcconfig cannot run this: it repeats the qemu-ios path and build_dir literally.
set -euo pipefail
PIN="$(cd "$(dirname "$0")/.." && pwd)/build-support/sources.json"
field() { plutil -extract "$1.$2" raw -o - "$PIN"; }
path() {
    local p
    case "$1" in
        qemu-ios) p="${QEMU_IOS_DIR:-}" ;;
        usbmuxd) p="${USBMUXD_SOURCE_DIR:-}" ;;
        *) echo "unknown checkout: $1" >&2; exit 2 ;;
    esac
    [ -n "$p" ] || p="$(field "$1" path)"
    p="${p/#\~/$HOME}"
    (cd "$p" 2>/dev/null && pwd -P) || echo "$p"
}
case "${1:-} ${2:-}" in
    "qemu-ios "|"usbmuxd ") path "$1" ;;
    "qemu-build ") if [ -n "${QEMU_BUILD_DIR:-}" ]; then (cd "$QEMU_BUILD_DIR" 2>/dev/null && pwd -P) || echo "$QEMU_BUILD_DIR"
                   else echo "$(path qemu-ios)/$(field qemu-ios build_dir)"; fi ;;
    "commit qemu-ios"|"commit usbmuxd") field "$2" commit ;;
    "check ")
        off=0
        for name in qemu-ios usbmuxd; do
            dir="$(path "$name")" pinned="$(field "$name" commit)"
            actual="$(git -C "$dir" rev-parse HEAD 2>/dev/null || echo "no git")"
            dirty=""; [ -z "$(git -C "$dir" status --porcelain 2>/dev/null)" ] || dirty=" (dirty)"
            if [ "$actual" = "$pinned" ] && [ -z "$dirty" ]; then state=ok; else state=DIFFERS; off=1; fi
            printf '%-8s %s: pinned %s, %s at %s%s\n' "$state" "$name" "${pinned:0:10}" "$dir" "${actual:0:10}" "$dirty"
        done
        exit $off ;;
    *) sed -n '2,9p' "$0" >&2; exit 2 ;;
esac
